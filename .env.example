DATABASE_URL=postgresql+psycopg://<your-username>@localhost:5432/coffwe_dev
# MQTT broker (generated by `uv run python -m coffwe.feed broker setup`)
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_DEVICES_PASSWORD=<generated>
MQTT_INGEST_PASSWORD=<generated>
MQTT_ADMIN_PASSWORD=<generated>
# Google Cloud Pub/Sub bridge (defaults shown; auth = impersonating the service account)
GCP_PROJECT=coffwe-estate-dt
PUBSUB_TOPIC=coffwe-sensor-readings
PUBSUB_SUBSCRIPTION=coffwe-twin-pull
BRIDGE_SERVICE_ACCOUNT=coffwe-bridge@coffwe-estate-dt.iam.gserviceaccount.com
BRIDGE_MONTHLY_BYTES=5368709120
